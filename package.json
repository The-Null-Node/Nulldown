{
  "name": "@thenullnode/nulldown",
  "version": "0.0.7",
  "private": false,
  "workspaces": [
    "packages/*"
  ],
  "description": "Deterministic structure for Markdown, agents, memory, and interfaces",
  "type": "module",
  "bin": {
    "nd": "bin/nulldown",
    "nulldown": "bin/nulldown"
  },
  "exports": {
    "./client": "./src/client/nulldown-client.ts",
    "./server/http": "./src/server/http.ts",
    "./server/runtime": "./src/server/runtime.ts",
    "./server/ports": "./src/server/ports.ts",
    "./server/nulledit": "./src/server/nulledit.ts",
    "./server/local": "./src/server/local.ts",
    "./server/bun-sqlite-store": "./src/server/bunSqliteStore.ts",
    "./server/memory-data-store": "./src/server/memoryDataStore.ts",
    "./server/filesystem-blob-store": "./src/server/filesystemBlobStore.ts",
    "./drop/branch": "./shared/drop/branch.ts",
    "./drop/diff": "./shared/drop/diff.ts",
    "./drop/runtime": "./shared/drop/runtime.ts",
    "./drop/authoring": "./shared/drop/authoringCrypto.ts",
    "./drop/resolved": "./shared/drop/resolved.ts",
    "./auth/cliDevice": "./shared/auth/cliDevice.ts",
    "./auth/cliCredential": "./src/cli/cli-credential.ts",
    "./nullmem": "./shared/nullmem.ts",
    "./nullplug/types": "./shared/nullplug/types.ts",
    "./nullplug/ui": "./shared/nullplug/ui.ts",
    "./nullplug/policy": "./shared/nullplug/policy.ts",
    "./nullplug/policyEvaluator": "./shared/nullplug/policyEvaluator.ts",
    "./nullplug/registry": "./shared/nullplug/registry.ts",
    "./nullplug/runtime": "./shared/nullplug/runtime.ts",
    "./nulledit/types": "./shared/nulledit/types.ts",
    "./nulledit/textDiff": "./shared/nulledit/textDiff.ts",
    "./nulledit/snapshotter": "./shared/nulledit/snapshotter.ts",
    "./nulledit/priorityQueue": "./shared/nulledit/priorityQueue.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "bin/nulldown",
    "bin/nulldown.ts",
    "src/cli/",
    "src/client/",
    "src/server/",
    "functions/api/_lib/",
    "migrations/",
    "shared/drop/",
    "shared/auth/",
    "shared/nullmem.ts",
    "shared/nullplug/",
    "shared/nulledit/",
    "AGENTS.md",
    "skill.md",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "nd": "bun run bin/nulldown.ts",
    "cli": "bun run bin/nulldown.ts",
    "mcp": "bun run packages/nulldown-mcp/bin/nulldown-mcp.ts",
    "cli:build": "bun run cli:build:current",
    "cli:build:current": "bun build --compile --minify --sourcemap --bytecode bin/nulldown.ts --outfile dist/nulldown",
    "mcp:build:current": "bun build --compile --minify --sourcemap --bytecode packages/nulldown-mcp/bin/nulldown-mcp.ts --outfile dist/nulldown-mcp",
    "bin:build:current": "bun run cli:build:current && bun run mcp:build:current",
    "bin:smoke": "bun run scripts/smoke-compiled-binaries.ts",
    "package:smoke-mcp": "bun run scripts/smoke-mcp-package.ts",
    "bench:resolved-heap": "bun run scripts/bench-resolved-heap.ts",
    "dev": "bunx --bun vite",
    "build": "bunx --bun vite build",
    "preview": "bunx --bun vite preview",
    "format:check": "prettier --check \"*.{js,cjs,mjs,ts,mts,cts,json,md,html,yml,yaml}\" .prettierrc.json \"{src,shared,functions,packages,scripts,bin,lib,docs}/**/*.{js,cjs,mjs,jsx,ts,tsx,mts,cts,json,jsonc,md,mdx,css,html,yml,yaml}\"",
    "lint": "eslint .",
    "typecheck": "bun run typecheck:web && bun run typecheck:functions && bun run typecheck:tooling && bun run typecheck:mcp && bun run typecheck:shared && bun run typecheck:configs && bun run typecheck:openauth && bun run typecheck:tests",
    "typecheck:web": "tsc --project tsconfig.check.web.json",
    "typecheck:functions": "tsc --project tsconfig.check.functions.json",
    "typecheck:tooling": "tsc --project tsconfig.check.tooling.json",
    "typecheck:mcp": "tsc --project tsconfig.check.mcp.json",
    "typecheck:shared": "tsc --project tsconfig.check.shared.json",
    "typecheck:configs": "tsc --project tsconfig.check.configs.json",
    "typecheck:openauth": "tsc --project tsconfig.check.openauth.json",
    "typecheck:tests": "bun run typecheck:tests:web && bun run typecheck:tests:functions && bun run typecheck:tests:tooling && bun run typecheck:tests:mcp && bun run typecheck:tests:shared && bun run typecheck:tests:openauth",
    "typecheck:tests:web": "tsc --project tsconfig.check.tests.json",
    "typecheck:tests:functions": "tsc --project tsconfig.check.tests.functions.json",
    "typecheck:tests:tooling": "tsc --project tsconfig.check.tests.tooling.json",
    "typecheck:tests:mcp": "tsc --project tsconfig.check.tests.mcp.json",
    "typecheck:tests:shared": "tsc --project tsconfig.check.tests.shared.json",
    "typecheck:tests:openauth": "tsc --project tsconfig.check.tests.openauth.json",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "package:check-cli": "bun run scripts/check-cli-package-boundary.ts",
    "package:check-mcp": "bun run scripts/check-mcp-package-boundary.ts",
    "test:diff-webhook": "bun run bin/nulldown.ts smoke diff",
    "diff:keygen": "bun run bin/nulldown.ts diff keygen",
    "diff:register": "bun run bin/nulldown.ts diff register",
    "diff:sign": "bun run bin/nulldown.ts diff sign",
    "branch:resolve": "bun run bin/nulldown.ts branch resolve",
    "branch:content": "bun run bin/nulldown.ts branch content",
    "branch:promote": "bun run bin/nulldown.ts branch promote",
    "branch:backfill": "bun run bin/nulldown.ts admin branch-backfill",
    "pages:build": "bunx --bun vite build",
    "pages:dev": "bun run build && wrangler pages dev dist --live-reload",
    "pages:dev:remote": "bun run build && wrangler pages dev dist --live-reload --remote",
    "logs": "wrangler pages deployment tail",
    "logs:prod": "wrangler pages deployment tail --environment production",
    "logs:preview": "wrangler pages deployment tail --environment preview",
    "deploy": "bun run pages:build && wrangler pages deploy dist"
  },
  "keywords": [
    "markdown",
    "deterministic-state",
    "agent-memory",
    "retrieval",
    "mcp",
    "document-runtime",
    "provenance",
    "self-hosted",
    "cloudflare"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.797.0",
    "minisearch": "^7.2.0",
    "nanoid": "^5.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@base-ui/react": "^1.2.0",
    "@cloudflare/workers-types": "^4.20260103.0",
    "@eslint/eslintrc": "^3",
    "@fontsource-variable/geist": "^5.2.8",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@tailwindcss/vite": "^4.2.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/bun": "^1.3.0",
    "@types/d3": "^7.4.3",
    "@types/jest": "^29.5.14",
    "@types/katex": "^0.16.7",
    "@types/node": "^20",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/react-katex": "^3.0.4",
    "@types/react-syntax-highlighter": "^15.5.11",
    "@vitejs/plugin-react": "^4.0.0",
    "autoprefixer": "^10.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3": "^7.9.0",
    "eslint": "^9",
    "fake-indexeddb": "^6.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jsdom": "^26.1.0",
    "katex": "^0.16.22",
    "lucide-react": "^0.577.0",
    "mermaid": "^11.6.0",
    "prettier": "^3.0.0",
    "react-katex": "^3.1.0",
    "react-markdown": "^8.0.7",
    "react-router-dom": "^7.6.0",
    "react-syntax-highlighter": "^15.6.1",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^3.0.1",
    "remark-math": "^6.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "shadcn": "^4.0.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4",
    "ts-jest": "^29.2.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "typescript-eslint": "^8.0.0",
    "unified": "^11.0.5",
    "vfile": "^6.0.3",
    "vfile-message": "^4.0.2",
    "vite": "^5.0.0",
    "wrangler": "4.127.0",
    "zustand": "^4.0.0"
  },
  "patchedDependencies": {
    "@openauthjs/openauth@0.4.3": "packages/nulldown-openauth/patches/@openauthjs%2Fopenauth@0.4.3.patch"
  }
}
