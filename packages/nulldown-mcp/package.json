{
  "name": "@thenullnode/nulldown-mcp",
  "version": "0.0.3",
  "private": false,
  "description": "A stdio MCP server for Nulldown API, branch, diff, and NullMem tools",
  "type": "module",
  "bin": {
    "nd-mcp": "bin/nulldown-mcp",
    "nulldown-mcp": "bin/nulldown-mcp"
  },
  "exports": {
    ".": "./src/server.ts",
    "./server": "./src/server.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "bin/nulldown-mcp",
    "bin/nulldown-mcp.ts",
    "src/",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "bun run bin/nulldown-mcp.ts",
    "pack:check": "npm pack --dry-run --json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@thenullnode/nulldown": ">=0.0.2 <0.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20"
  }
}
