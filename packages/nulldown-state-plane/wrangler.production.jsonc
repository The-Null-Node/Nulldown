{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "nulldown-state-plane-production",
  "main": "src/production-worker.ts",
  "compatibility_date": "2026-10-28",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "upload_source_maps": true,
  "durable_objects": {
    "bindings": [{ "name": "BRANCH_STATE", "class_name": "BranchStateObject" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["BranchStateObject"] }],
  "vars": {
    "ENVIRONMENT": "production",
    "STATE_PLANE_LOCAL_TEST": "0",
    "STATE_PLANE_CANARY_ROOT": "1rIbFszcNmrt",
    "STATE_PLANE_OUTBOX_ENABLED": "0",
  },
  "r2_buckets": [{ "binding": "LEGACY_R2", "bucket_name": "nulldown" }],
  "d1_databases": [
    {
      "binding": "LEGACY_D1",
      "database_name": "nulldown-search",
      "database_id": "f5ed3a68-61ca-403d-9eb8-6c5fdc0369a6",
      "migrations_dir": "../../migrations",
    },
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "enabled": true, "invocation_logs": false },
    "traces": { "enabled": false },
  },
}
