{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "nulldown-state-plane-local",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-28",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "upload_source_maps": true,
  "durable_objects": {
    "bindings": [{ "name": "BRANCH_STATE", "class_name": "BranchStateObject" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["BranchStateObject"] }],
  "vars": { "STATE_PLANE_LOCAL_TEST": "0" },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "enabled": true, "invocation_logs": false },
  },
}
